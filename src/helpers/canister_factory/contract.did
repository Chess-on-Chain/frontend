type WebsocketMessageQueue = 
 record {
   body: blob;
   method: text;
   "principal": principal;
 };
type User = 
 record {
   country: opt text;
   draw: nat16;
   fullname: text;
   id: text;
   is_banned: bool;
   lost: nat16;
   photo: opt blob;
   score: nat16;
   username: opt text;
   win: nat16;
 };
type Result_9 = 
 variant {
   err: text;
   ok: MatchResultHistory;
 };
type Result_8 = 
 variant {
   err: text;
   ok: File;
 };
type Result_7 = 
 variant {
   err: text;
   ok: vec User;
 };
type Result_6 = 
 variant {
   err: text;
   ok: vec MatchResultHistory;
 };
type Result_5 = 
 variant {
   err: text;
   ok: MatchResult;
 };
type Result_4 = 
 variant {
   err: text;
   ok: principal;
 };
type Result_3 = 
 variant {
   err: text;
   ok: User;
 };
type Result_2 = 
 variant {
   err: text;
   ok: MatchCreated;
 };
type Result_1 = 
 variant {
   err: text;
   ok: Match;
 };
type Result = 
 variant {
   err: text;
   ok: bool;
 };
type Move = 
 record {
   fen: text;
   time: nat64;
 };
type MatchResultHistory = 
 record {
   black_player: principal;
   id: nat64;
   is_ranked: bool;
   moves: vec Move;
   time: nat64;
   white_player: principal;
   winner: text;
 };
type MatchResult = 
 record {
   black_player: User;
   id: nat64;
   is_ranked: bool;
   moves: vec Move;
   time: nat64;
   white_player: User;
   winner: text;
 };
type MatchCreated = 
 variant {
   match: Match;
   "text": text;
 };
type Match = 
 record {
   black_player: principal;
   fen: text;
   id: nat64;
   is_ranked: bool;
   is_white_turn: bool;
   last_move: nat64;
   moves: vec Move;
   time: nat64;
   white_player: principal;
   winner: text;
 };
type File = 
 record {
   data: blob;
   filename: text;
   hash: blob;
 };
type EditUser = 
 record {
   country: opt text;
   fullname: opt text;
   photo: opt record {
                data: blob;
                extension: text;
              };
   username: opt text;
 };
service : {
  accept_friendship: (from: principal) -> (Result);
  accept_match: (friend_principal: principal) -> (Result_1);
  cancel_match_room: () -> ();
  change_initial_fen: (new_initial_fen: text) -> () oneway;
  edit_user: (new_user: EditUser) -> (Result);
  get_active_match: (user_principal: principal) -> (Result_9) query;
  get_file: (file_id_hex: text) -> (Result_8) query;
  get_friends: (user_principal: principal, incoming: bool) ->
   (Result_7) query;
  get_histories: (user_principal: principal, start: nat, max: nat) ->
   (Result_6) query;
  get_match: (match_id: nat64) -> (Result_5) query;
  get_principal_from_username: (username: text) -> (Result_4) query;
  get_user: (user_id: principal) -> (Result_3) query;
  initialize: (_owner: principal, _chess_engine_principal: principal) ->
   () oneway;
  invite_match: (friend_principal: principal) -> (Result);
  make_match: (is_rank: bool) -> (Result_2);
  make_move: (match_id: nat64, from_position: text, to_position: text,
   promotion: opt text) -> (Result_1);
  pop_messages: () -> (vec WebsocketMessageQueue);
  register: () -> ();
  reject_friendship: (from: principal) -> (Result);
  resign: () -> (Result);
  send_friendship: (to: principal) -> (Result);
}
